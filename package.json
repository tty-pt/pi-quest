{
  "name": "@tty-pt/pi-quest",
  "version": "1.7.0",
  "description": "Quest Journal & Epistemic Workflow Extension for Pi Coding Agent (v2, layered rebuild)",
  "keywords": [
    "pi-package",
    "quest",
    "workflow"
  ],
  "license": "BSD-2-Clause",
  "author": "quirinpa",
  "homepage": "https://github.com/tty-pt/pi-quest",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tty-pt/pi-quest.git"
  },
  "bugs": {
    "url": "https://github.com/tty-pt/pi-quest/issues"
  },
  "icon": "thumb.png",
  "files": [
    "index.ts",
    "src",
    "skills",
    "README.md",
    "LICENSE",
    "cover.png",
    "thumb.png"
  ],
  "main": "index.ts",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "deno test --allow-all --sloppy-imports --node-modules-dir=none tests/",
    "lint": "deno lint",
    "zip": "deno run --allow-all scripts/zip_bundle.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-agent-core": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true }
  },
  "pi": {
    "image": "cover.png",
    "extensions": [
      "index.ts"
    ],
    "skills": [
      "skills/quest-journal/SKILL.md"
    ]
  }
}